// test pass string literals as parameter

proc main()
  {
    var firstName : String := "Jane";
    var lastName : String;
    lastName := "Doe";
    writeConcatenatedStrings(firstName, " ");
    writeStringChars(lastName);
    writeln;
    writeln("Jane Doe");
  }

// write out concatenated strings
proc writeConcatenatedStrings(var s1 : String, s2 : String)
  {
    writeStringChars(s1);
    write(s2);
  }

proc writeStringChars(name : String)
  {
    for i in 0..name.length - 1 loop
        write name[i];
  }
