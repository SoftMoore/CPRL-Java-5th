proc main()
  {
    var line : String;

    writeln "Enter lines (\":q\" to quit): ";
    loop
      {
        read line;
        exit when shouldExit(line);
        writeln line;
      }
  }

fun shouldExit(line : String) : Boolean
  {
    return line.length = 2 and line[0] = ':' and line[1] = 'q';
  }
