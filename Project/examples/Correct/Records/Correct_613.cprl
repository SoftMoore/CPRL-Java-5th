type MonthEnum = <invalid,
                  January, February, March,
                  April,   May,      June,
                  July,    August,   September,
                  October, November, December>;

type Month = record
  {
    name    : String;
    maxDays : Integer;
  };

var  months : array[13] of Month :=
        {
          { "invalid",    0 },
          { "January",   31 }, { "February",  29 }, { "March",     31 },
          { "April",     30 }, { "May",       31 }, { "June",      30 },
          { "July",      31 }, { "August",    31 }, { "September", 30 },
          { "October",   31 }, { "November",  30 }, { "December",  31 }
        };

proc writeMonth(m : Month)
  {
    write "Month ", m.name, " has a maximum of ", m.maxDays, " days.";
  }

proc main()
  {
    for m in MonthEnum.January..MonthEnum.December loop
      {
        writeMonth(months[m]);
        writeln;
      }
  }
